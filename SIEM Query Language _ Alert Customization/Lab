#!/bin/bash
QUERY_FILE=$1

if [ ! -f "$QUERY_FILE" ]; then
    echo "Query file not found: $QUERY_FILE"
    exit 1
fi

# Validate JSON syntax
if ! jq empty "$QUERY_FILE" 2>/dev/null; then
    echo "Invalid JSON syntax in $QUERY_FILE"
    exit 1
