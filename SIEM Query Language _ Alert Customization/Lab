Subtask 3.2: Create Custom Alert Rules
Create a rule for multiple failed logins:
sudo tee /var/ossec/etc/rules/custom/100-custom_auth_rules.xml << 'EOF'
<group name="custom,authentication,">
  
  <!-- Rule for detecting brute force attacks -->
  <rule id="100001" level="10">
    <if_matched_sid>5503</if_matched_sid>
    <same_source_ip />
    <description>Multiple authentication failures from same source IP</description>
    <options>no_email_alert</options>
    <group>authentication_failures,brute_force,</group>
  </rule>

  <!-- Rule for detecting successful login after failures -->
  <rule id="100002" level="8">
    <if_matched_sid>5501</if_matched_sid>
    <same_source_ip />
    <description>Successful authentication after multiple failures</description>
    <group>authentication_success,potential_compromise,</group>
  </rule>

  <!-- Rule for detecting root login attempts -->
  <rule id="100003" level="12">
    <if_matched_sid>5503</if_matched_sid>
    <user>root</user>
    <description>Failed root login attempt detected</description>
    <group>authentication_failures,root_access,</group>
  </rule>

</group>
EOF
Create rules for file system monitoring:
sudo tee /var/ossec/etc/rules/custom/101-custom_syscheck_rules.xml << 'EOF'
<group name="custom,syscheck,">
  
  <!-- Rule for critical file modifications -->
  <rule id="101001" level="12">
    <if_matched_sid>550</if_matched_sid>
    <field name="file">/etc/passwd|/etc/shadow|/etc/sudoers</field>
    <description>Critical system file modified: $(file)</description>
    <group>syscheck,critical_files,</group>
  </rule>

  <!-- Rule for suspicious binary execution -->
  <rule id="101002" level="10">
    <if_matched_sid>550</if_matched_sid>
    <field name="file">/tmp/|/var/tmp/</field>
    <field name="file">\.sh$|\.py$|\.pl$</field>
    <description>Suspicious script execution in temporary directory: $(file)</description>
    <group>syscheck,suspicious_execution,</group>
  </rule>

</group>
EOF
