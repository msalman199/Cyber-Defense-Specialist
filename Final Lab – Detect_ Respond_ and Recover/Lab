Task 3: Simulate Attack Scenarios
Step 3.1: Generate SSH Brute Force Attack
# Create attack simulation script
cat > ~/soc-lab/attack-simulation/ssh_bruteforce.sh << 'EOF'
#!/bin/bash
# Simulate SSH brute force attack (for testing only)

TARGET="localhost"
ATTEMPTS=10

echo "Simulating SSH brute force attack..."
for i in $(seq 1 $ATTEMPTS); do
    # Attempt login with invalid credentials
    sshpass -p "wrongpassword" ssh -o StrictHostKeyChecking=no testuser@$TARGET 2>/dev/null
    sleep 1
done

echo "Attack simulation complete. Check Wazuh alerts."
EOF

chmod +x ~/soc-lab/attack-simulation/ssh_bruteforce.sh
Step 3.2: Generate Port Scan Activity
cat > ~/soc-lab/attack-simulation/port_scan.sh << 'EOF'
#!/bin/bash
# Simulate port scanning activity

TARGET="127.0.0.1"
echo "Simulating port scan..."

# Scan common ports
for port in {20..100}; do
    timeout 1 bash -c "echo >/dev/tcp/$TARGET/$port" 2>/dev/null && echo "Port $port open"
done

echo "Port scan simulation complete."
EOF

chmod +x ~/soc-lab/attack-simulation/port_scan.sh
